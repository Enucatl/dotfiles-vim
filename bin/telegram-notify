#!/bin/bash

set -u

[ "$#" -le 1 ] || { echo "Usage: telegram-notify [message]" >&2; exit 2; }
[ -n "${TELEGRAM_BOT_TOKEN:-}" ] || { echo "telegram-notify: TELEGRAM_BOT_TOKEN is required" >&2; exit 1; }
[ -n "${TELEGRAM_CHAT_ID:-}" ] || { echo "telegram-notify: TELEGRAM_CHAT_ID is required" >&2; exit 1; }

if [ "$#" -eq 1 ]; then
  message=$1
else
  message=$(cat)
fi
[ -n "$message" ] || { echo "telegram-notify: message is required" >&2; exit 1; }

exec 3<<<"url = \"https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage\""
curl --fail --silent --show-error --output /dev/null --config /dev/fd/3 \
  --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" --data-urlencode text@- <<<"$message"
